# This project targets rev 1.x silicon (see README). IDF 6.0 defaults to rev
# >= 3.01, and rev <3 / >=3 binaries are mutually incompatible ("huge hardware
# difference" per IDF Kconfig) - a rev-3 image on rev 1.3 dies at boot with an
# illegal-instruction panic loop.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# P4-nano ships 16 MB flash; the 2 MB default made the bootloader warn and
# capped the app at a 1 MB factory partition that was 95 % full.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Full-frame capture @ 1080p needs PSRAM (ping-pong buffers + JPEG + HTTP copy).
# esp_http_server: max_open_sockets + 3 internal fds must be <= CONFIG_LWIP_MAX_SOCKETS.
# Headroom for concurrent /stream + /jpeg-quality + /ws (and dev proxy opening several TCPs).
CONFIG_LWIP_MAX_SOCKETS=24

CONFIG_P4KVM_JPEG_QUALITY=70

# Product feature toggles. These match the Kconfig defaults, but are pinned
# here so a pre-existing sdkconfig (generated before a default flipped) can't
# silently build a feature out - which is exactly how a WireGuard-less image
# shipped once (sdkconfig kept "WG_ENABLE is not set" from an earlier build).
CONFIG_P4KVM_WIFI_ENABLE=y
CONFIG_P4KVM_ETH_ENABLE=y
CONFIG_P4KVM_WG_ENABLE=y

# WebSocket /ws for browser → USB HID control plane
CONFIG_HTTPD_WS_SUPPORT=y
# Lets P4KVM_AUTH_ENABLE reject /ws before the 101 upgrade (handshake runs before the URI handler)
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
# Default 1024 is too small for Chromium + Vite proxy (sec-ch-ua-*, cookies) → 431 on device.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=8192

# Composite HID keyboard + mouse (TinyUSB)
CONFIG_TINYUSB_HID_COUNT=1

# ESP32-P4 AP-HEX PSRAM size (e.g. 32 MB) is detected at boot - no separate "32MB" Kconfig.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

# MJPEG pushes large JPEG segments; lwIP defaults (~5.8 KiB) cause backpressure/resets on Ethernet.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=6144
