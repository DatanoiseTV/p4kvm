# This project targets rev 1.x silicon (see README). IDF 6.0 defaults to rev
# >= 3.01, and rev <3 / >=3 binaries are mutually incompatible ("huge hardware
# difference" per IDF Kconfig) - a rev-3 image on rev 1.3 dies at boot with an
# illegal-instruction panic loop.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# P4-nano ships 16 MB flash; the 2 MB default made the bootloader warn and
# capped the app at a 1 MB factory partition that was 95 % full.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Full-frame capture @ 1080p needs PSRAM (ping-pong buffers + JPEG + HTTP copy).
# esp_http_server: max_open_sockets + 3 internal fds must be <= CONFIG_LWIP_MAX_SOCKETS.
# Headroom for concurrent /stream + /jpeg-quality + /ws (and dev proxy opening several TCPs).
CONFIG_LWIP_MAX_SOCKETS=24

CONFIG_P4KVM_JPEG_QUALITY=70

# Product feature toggles. These match the Kconfig defaults, but are pinned
# here so a pre-existing sdkconfig (generated before a default flipped) can't
# silently build a feature out - which is exactly how a WireGuard-less image
# shipped once (sdkconfig kept "WG_ENABLE is not set" from an earlier build).
CONFIG_P4KVM_WIFI_ENABLE=y
CONFIG_P4KVM_ETH_ENABLE=y
CONFIG_P4KVM_WG_ENABLE=y

# esp_wireguard creates a raw lwIP netif and stores its own device struct in
# netif->state. With the default LWIP_ESP_NETIF_DATA=0, esp_netif's global
# ext-callback (esp_netif_internal_dhcpc_cb) reads netif->state as an esp_netif_t
# and null-derefs its ip_info the moment the WG netif's address is set -> Load
# access fault boot loop. lwipopts.h only sets LWIP_ESP_NETIF_DATA=1 (esp_netif
# then keeps its back-pointer in netif->client_data, leaving state free for the
# WG device) when the bridge or PPP option is on. We enable the bridge purely
# for that side effect; no bridge is ever created. The +1 slot below keeps the
# count explicit (esp_netif needs one; LWIP_ESP_NETIF_DATA already adds it).
CONFIG_ESP_NETIF_BRIDGE_EN=y
CONFIG_LWIP_NUM_NETIF_CLIENT_DATA=1

# WebSocket /ws for browser → USB HID control plane
CONFIG_HTTPD_WS_SUPPORT=y
# Lets P4KVM_AUTH_ENABLE reject /ws before the 101 upgrade (handshake runs before the URI handler)
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
# Default 1024 is too small for Chromium + Vite proxy (sec-ch-ua-*, cookies) → 431 on device.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=8192

# Composite HID keyboard + mouse (TinyUSB)
CONFIG_TINYUSB_HID_COUNT=1

# Virtual media: raw-block MSC. esp_tinyusb's built-in tud_msc_* callbacks are
# vendored + weakened (components/espressif__esp_tinyusb) so main/usb_msc.c can
# present an arbitrary PSRAM/SD image instead of the driver's FAT-on-flash LUN.
# BUFSIZE must be >= the HS bulk max-packet (512) and is the read/write chunk.
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=8192

# USB CDC-ACM serial console: a third function (virtual COM / ttyACM on the
# target) bridged to a browser terminal over /serial. Disabling this flips the
# composite descriptor back to HID+MSC (usb_hid.c / usb_serial.c are guarded on
# it), a safe fallback if a target enumerates the 4-interface device poorly.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_RX_BUFSIZE=512
CONFIG_TINYUSB_CDC_TX_BUFSIZE=512

# ESP32-P4 AP-HEX PSRAM size (e.g. 32 MB) is detected at boot - no separate "32MB" Kconfig.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

# WebRTC path: hardware H.264 video track + SCTP data-channel HID/serial,
# alongside MJPEG (browser auto-falls-back to MJPEG-over-WS if the peer
# connection fails). Needs the YUV422 pipeline (the H.264 encoder consumes UYVY
# directly). esp_peer's DTLS-SRTP needs these mbedtls options; MBEDTLS_X509_
# CREATE_C is additionally required on IDF 6.0 (mbedtls 4) for the self-signed
# DTLS cert. EXPERIMENTAL - not yet hardware-verified; the MJPEG fallback keeps
# the KVM usable regardless.
CONFIG_P4KVM_PIPELINE_YUV422=y
CONFIG_P4KVM_WEBRTC_ENABLE=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y
CONFIG_MBEDTLS_X509_CREATE_C=y

# MJPEG pushes large JPEG segments; lwIP defaults (~5.8 KiB) cause backpressure/resets on Ethernet.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=6144

# Socket-pool exhaustion guard. The browser re-fetches /stream (and reconnects
# /ws, /serial) on any hiccup; each closed TCP then sits in TIME_WAIT. The lwIP
# default MSL of 60 s means a closed socket is held for a full minute, so a few
# reconnects per minute exhaust the 24-socket pool -> httpd accept() ENFILE
# (errno 23), the whole server wedges. 5 s TIME_WAIT is ample on a LAN/tunnel
# and lets churned sockets free almost immediately. Give the TCP PCB pool
# headroom to match the socket count (httpd holds up to 12 + a few transient).
CONFIG_LWIP_TCP_MSL=5000
CONFIG_LWIP_MAX_ACTIVE_TCP=24
